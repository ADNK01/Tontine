# ---------------------------------------------------------------------------
# Profil MoonX futures — compte crypto a tailles fractionnaires.
# Copiez en .env pour travailler sur ce profil.
#
# CE FICHIER NE CONTIENT AUCUNE CLE. Le bot n'envoie jamais d'ordre : il produit
# un ticket (npm run propose) qu'un humain relit avant d'agir.
# ---------------------------------------------------------------------------
TRADING_MODE=paper
STRATEGY=enigma
SYMBOL=BTCUSDT
INTERVAL=15m

# --- Compte ---
# Solde du portefeuille futures, en USDT. A remettre a jour apres chaque variation.
ACCOUNT_BALANCE=19.6
# 2% de 19.60 = 0.39 USDT de perte maximale par trade.
RISK_PER_TRADE=0.02

# --- Contraintes de taille : A VERIFIER dans l'application MoonX ---
# Sur des futures crypto la taille est fractionnaire, contrairement aux lots MT4.
CONTRACT_SIZE=1
MIN_LOT=0.001
LOT_STEP=0.0001
MAX_POSITION=0.01

# --- Strategie Enigma (valeurs de vos captures MT4) ---
ATR_PERIOD=14
MOMENTUM_BARS=8
BEAR_CONTEXT_MAX=0.4
BULL_CONTEXT_MIN=0.6
BULL_REVERSAL_MIN=0.72
BEAR_REVERSAL_MAX=0.28
MIN_BODY_EFFICIENCY=0.25
MIN_RANGE_ATR=0.5
USE_CONTEXT_DEPTH=true
MIN_CONTEXT_DEPTH=0.05
USE_HTF=true
HTF_FACTOR=4
HTF_MIN_PRESSURE=0.6
SL_ATR_MULTI=1.8
TP1_RR=1.0
TP2_RR=2.0
TP3_RR=3.0
TARGET_RR=1
