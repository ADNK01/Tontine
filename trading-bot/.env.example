# ---------------------------------------------------------------------------
# Bot de paper-trading — configuration
# Copiez ce fichier en .env et adaptez. .env est ignore par git.
# AUCUNE CLE API N'EST NECESSAIRE : le bot ne lit que des donnees publiques
# et ne passe jamais d'ordre reel.
# ---------------------------------------------------------------------------

# --- Garde-fou principal : seule la valeur "paper" est acceptee ---
TRADING_MODE=paper

# --- Marche ---
SYMBOL=BTCUSDT
INTERVAL=5m
CANDLE_LIMIT=500
KLINES_BASE_URL=https://api.binance.com
HTTP_TIMEOUT_MS=15000
# true = repli sur le snapshot de bougies REELLES de data/cache/ si l'API est injoignable
# false = le bot echoue plutot que d'utiliser des donnees non temps reel
ALLOW_CACHE_FALLBACK=true

# --- Strategie ---
FAST_MA=9
SLOW_MA=21
REGIME_MA=50

# --- Risque ---
QUANTITY=0.01
MAX_POSITION=0.05

# --- Replay ---
REPLAY_HORIZON=12

# --- Memoire ---
MEMORY_MIN_LOSSES=2
MEMORY_MAX_WIN_RATE=0.5
