# ---------------------------------------------------------------------------
# Bot de paper-trading — configuration
# Copiez ce fichier en .env et adaptez. .env est ignore par git.
# AUCUNE CLE API N'EST NECESSAIRE : le bot ne lit que des donnees publiques
# et ne passe jamais d'ordre reel.
# ---------------------------------------------------------------------------

# --- Garde-fou principal : seule la valeur "paper" est acceptee ---
TRADING_MODE=paper

# --- Strategie active : enigma (defaut) ou ma ---
STRATEGY=enigma

# --- Marche ---
SYMBOL=BTCUSDT
INTERVAL=15m
CANDLE_LIMIT=500
KLINES_BASE_URL=https://api.binance.com
HTTP_TIMEOUT_MS=15000
# true = repli sur le snapshot de bougies REELLES de data/cache/ si l'API est injoignable
# false = le bot echoue plutot que d'utiliser des donnees non temps reel
ALLOW_CACHE_FALLBACK=true

# --- Strategie MA (si STRATEGY=ma) ---
FAST_MA=9
SLOW_MA=21
REGIME_MA=50

# --- Strategie Enigma Cipher (valeurs des captures MT4) ---
ATR_PERIOD=14
MOMENTUM_BARS=8
BEAR_CONTEXT_MAX=0.4
BULL_CONTEXT_MIN=0.6
BULL_REVERSAL_MIN=0.72
BEAR_REVERSAL_MAX=0.28
MIN_BODY_EFFICIENCY=0.25
MIN_RANGE_ATR=0.5
REQUIRE_CONFIRMATION=false
CONFIRMATION_BARS=1
FILTER_READY_WINDOW=5
# cooldown = une fleche par retournement (defaut) | armed = fenetre apres cloture HTF
READY_MODE=cooldown
# Decalage du serveur MT4 (FBS = UTC+3, deduit de la fleche calibree)
SERVER_UTC_OFFSET=3
USE_CONTEXT_DEPTH=true
MIN_CONTEXT_DEPTH=0.05
# clarity = nettete du contexte (defaut) | sweep = balayage de l'extreme
CONTEXT_DEPTH_MODE=clarity
USE_HTF=true
HTF_FACTOR=4
HTF_MIN_PRESSURE=0.6
# aligned (elimine par la fleche calibree) | contrarian (defaut) | clear | off
HTF_MODE=contrarian
HTF_MIN_BODY_ATR=0.0
SL_ATR_MULTI=1.8
TP1_RR=1.0
TP2_RR=2.0
TP3_RR=3.0
TARGET_RR=1

# --- Compte et dimensionnement (A VERIFIER dans MT4 : clic droit sur le symbole -> Specification) ---
ACCOUNT_BALANCE=20
RISK_PER_TRADE=0.01
CONTRACT_SIZE=1
MIN_LOT=0.01
LOT_STEP=0.01

# --- Risque ---
QUANTITY=0.01
MAX_POSITION=0.05

# --- Replay ---
REPLAY_HORIZON=12

# --- Memoire ---
MEMORY_MIN_LOSSES=2
MEMORY_MAX_WIN_RATE=0.5
